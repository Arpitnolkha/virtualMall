# Server-only. No secret should use NEXT_PUBLIC_. Copy into .env.local.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
# Enable Conversational AI and Agora ARES ASR for this project in Agora Console.
# Anam avatar integration via Agora. Leave blank for audio-only fallback.
ANAM_API_KEY=
ANAM_AVATAR_ID=
MURF_API_KEY=
# Plain voice ID only, for example Anisha. Do not paste a JSON settings object.
MURF_VOICE_ID=
